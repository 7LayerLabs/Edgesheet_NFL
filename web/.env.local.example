# EdgeSheet NFL. Copy to .env.local. No key is needed for the data layer (nflverse is public).

# The Odds API (free tier, 500 credits a month, SHARED with the college EdgeSheet).
# NFL snapshots run every 6 hours Thu to Mon; college every 4 hours Wed to Sat; props on demand only.
ODDS_API_KEY=

# Written reports, watch guides, Ask the slate.
ANTHROPIC_API_KEY=

# TypeSafe Jev (ranks watch-guide candidates, classifies feed posts). Optional; code degrades without it.
TYPESAFE_API_KEY=

# Telegram delivery. One bot per app: create a NEW bot with @BotFather, do not reuse the college bot's token.
# Then message the bot once and run: npm run telegram:chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Identifies the app to the National Weather Service.
NWS_USER_AGENT=EdgeSheetNFL/0.1

# Base URL used in Telegram links and by the sheet renderer. The NFL app runs on 3100 (college is 3000).
PUBLIC_BASE_URL=http://localhost:3100
PORT=3100

# Where the Rookies page's "Incoming" tab links (the college EdgeSheet forecast board).
COLLEGE_EDGESHEET_URL=http://localhost:3000/draft
